{
  "schema_version": 1,
  "policy": "default-deny",
  "required_paths": [
    "LICENSE",
    "UPSTREAM.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE_POLICY.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "README.md",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml"
  ],
  "include_files": [
    ".dockerignore",
    ".gitignore",
    ".npmrc",
    ".prettierignore",
    "AGENTS.md",
    "ARCHITECTURE.md",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "DECISIONS.md",
    "Dockerfile",
    "LICENSE",
    "LICENSE_POLICY.md",
    "NOTICE.md",
    "README.md",
    "README.en.md",
    "README.zh-CN.md",
    "RISKS.md",
    "ROADMAP.md",
    "SECURITY.md",
    "TASKS.md",
    "THIRD_PARTY_NOTICES.md",
    "THREAT_MODEL.md",
    "UPSTREAM.md",
    "docker-compose.yml",
    "eslint.config.mjs",
    "nginx.conf",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "turbo.json",
    ".github/PULL_REQUEST_TEMPLATE.md",
    ".github/dependabot.yml",
    ".husky/pre-commit",
    "downloads/MANIFEST.public.json",
    "third_party/SOURCE_REGISTRY.md",
    "release/public-allowlist.json",
    "release/public-denylist.json",
    "release/public-release-manifest.json",
    "release/RELEASE_MANIFEST.json",
    "release/SHA256SUMS",
    "release/BUILD_INFO.json",
    "release/PROVENANCE.json",
    "release/sbom-source.spdx.json",
    "release/sbom-runtime.cdx.json",
    "reports/apps-server-license-analysis.md",
    "reports/apps-server-dependency-map.json",
    "reports/apps-server-removal-verification.md",
    "reports/public-boundary-scan.json",
    "reports/public-history-scan.json",
    "reports/release-artifact-scan.json",
    "reports/round4-evidence-privacy.json",
    "reports/round4-verification.md",
    "reports/round4-dependency-security.md",
    "reports/round3-wechat-official-contract.md",
    "reports/license-compatibility-matrix.md"
  ],
  "include_directories": [
    ".agents/skills",
    ".github/ISSUE_TEMPLATE",
    ".github/workflows",
    "apps/cli",
    "apps/electron",
    "apps/mcp",
    "apps/mock-wechat",
    "apps/web",
    "docs",
    "examples",
    "packages",
    "scripts",
    "templates",
    "tests",
    "third_party/licenses"
  ],
  "conditional_globs": [
    "artifacts/evidence/round-4/*.png",
    "artifacts/evidence/round-4/*.gif"
  ],
  "allowed_public_tags": ["v0.1.0"],
  "notes": [
    "Every unlisted path is denied.",
    "Conditional evidence files require provenance, privacy, and license gates before export.",
    "Local downloads are represented by MANIFEST.public.json; downloaded payloads are never exported."
  ]
}
